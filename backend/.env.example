# ========================================
# Expanzo Production Environment Variables
# ========================================
# IMPORTANT: Copy this file to '.env' on your AWS server and fill in the values!

# Django Core Settings
DEBUG=False
SECRET_KEY=change-this-to-a-very-long-random-string
ALLOWED_HOSTS=api.yourdomain.com,localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=https://your-frontend-vercel.app

# Database Configuration (Postgres)
# These will be read by both Django (to connect) and the DB container (to initialize)
POSTGRES_DB=expanzo_db
POSTGRES_USER=expanzo_user
POSTGRES_PASSWORD=change-this-to-a-secure-db-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis & Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# AI Provider API Keys (Fill with your actual keys)
GEMINI_API_KEY=your-gemini-api-key
HUGGINGFACE_API_KEY=your-huggingface-api-key

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=your-razorpay-key
RAZORPAY_KEY_SECRET=your-razorpay-secret

# Any other specific settings
# ...
